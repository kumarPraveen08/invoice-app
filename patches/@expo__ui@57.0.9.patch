@@ -0,0 +1,172 @@
+import { requireNativeView } from 'expo';
+import type { ReactNode } from 'react';
+import type { ColorValue, StyleProp, ViewStyle } from 'react-native';
+
+import type { ModifierConfig, ViewEvent } from '../../types';
+import { createViewModifierEventListener } from '../modifiers/utils';
+
+const FloatingActionButtonMenuNativeView: React.ComponentType<NativeFloatingActionButtonMenuProps> =
+  requireNativeView('ExpoUI', 'FloatingActionButtonMenuView');
+
+const ToggleFloatingActionButtonNativeView: React.ComponentType<NativeToggleFloatingActionButtonProps> =
+  requireNativeView('ExpoUI', 'ToggleFloatingActionButtonView');
+
+const FloatingActionButtonMenuItemNativeView: React.ComponentType<NativeFloatingActionButtonMenuItemProps> =
+  requireNativeView('ExpoUI', 'FloatingActionButtonMenuItemView');
+
+const SlotNativeView: React.ComponentType<{
+  slotName: string;
+  children: React.ReactNode;
+}> = requireNativeView('ExpoUI', 'SlotView');
+
+export type FloatingActionButtonMenuHorizontalAlignment = 'start' | 'end' | 'center';
+
+export interface FloatingActionButtonMenuProps {
+  /**
+   * Whether the FAB menu is expanded.
+   */
+  expanded?: boolean;
+  /**
+   * Horizontal alignment of menu items relative to the toggle button.
+   * @default 'end'
+   */
+  horizontalAlignment?: FloatingActionButtonMenuHorizontalAlignment;
+  /**
+   * Toggle button (typically `ToggleFloatingActionButton`) and menu items.
+   */
+  children: ReactNode;
+  style?: StyleProp<ViewStyle>;
+  modifiers?: ModifierConfig[];
+}
+
+type NativeFloatingActionButtonMenuProps = {
+  expanded?: boolean;
+  horizontalAlignment?: FloatingActionButtonMenuHorizontalAlignment;
+  style?: StyleProp<ViewStyle>;
+  modifiers?: ModifierConfig[];
+  children?: ReactNode;
+};
+
+/**
+ * Slot for the FAB that toggles the menu — usually a `ToggleFloatingActionButton`.
+ */
+export function Button(props: { children: ReactNode }) {
+  return <SlotNativeView slotName="button">{props.children}</SlotNativeView>;
+}
+Button.tag = 'Button';
+
+/**
+ * Slot for `FloatingActionButtonMenuItem` children.
+ */
+export function Items(props: { children: ReactNode }) {
+  return <SlotNativeView slotName="items">{props.children}</SlotNativeView>;
+}
+Items.tag = 'Items';
+
+/**
+ * Material 3 Expressive [FloatingActionButtonMenu](https://developer.android.com/reference/kotlin/androidx/compose/material3/package-summary#FloatingActionButtonMenu(kotlin.Boolean,kotlin.Function0,androidx.compose.ui.Modifier,androidx.compose.ui.Alignment.Horizontal,kotlin.Function1)).
+ */
+function FloatingActionButtonMenu(props: FloatingActionButtonMenuProps) {
+  const { modifiers, ...restProps } = props;
+  return (
+    <FloatingActionButtonMenuNativeView
+      style={props.style}
+      modifiers={modifiers}
+      {...(modifiers ? createViewModifierEventListener(modifiers) : undefined)}
+      {...restProps}
+    />
+  );
+}
+
+FloatingActionButtonMenu.Button = Button;
+FloatingActionButtonMenu.Items = Items;
+
+export { FloatingActionButtonMenu };
+
+export interface ToggleFloatingActionButtonProps {
+  checked: boolean;
+  onCheckedChange?: (checked: boolean) => void;
+  /**
+   * Solid container color for both checked and unchecked states.
+   * When omitted, uses Material 3 ToggleFloatingActionButton defaults.
+   */
+  containerColor?: ColorValue;
+  modifiers?: ModifierConfig[];
+  children: React.ReactNode;
+}
+
+type NativeToggleFloatingActionButtonProps = Omit<
+  ToggleFloatingActionButtonProps,
+  'onCheckedChange' | 'children'
+> & {
+  children?: React.ReactNode;
+} & ViewEvent<'onCheckedChange', { checked: boolean }>;
+
+function FABIcon(props: { children: React.ReactNode }) {
+  return <SlotNativeView slotName="icon">{props.children}</SlotNativeView>;
+}
+
+/**
+ * Material 3 Expressive [ToggleFloatingActionButton](https://developer.android.com/reference/kotlin/androidx/compose/material3/package-summary#ToggleFloatingActionButton(kotlin.Boolean,kotlin.Function1,androidx.compose.ui.Modifier,kotlin.Function1,androidx.compose.ui.Alignment,kotlin.Function1,kotlin.Function1,kotlin.Function1)).
+ */
+function ToggleFloatingActionButtonComponent(props: ToggleFloatingActionButtonProps) {
+  const { children, onCheckedChange, modifiers, ...rest } = props;
+  return (
+    <ToggleFloatingActionButtonNativeView
+      {...rest}
+      modifiers={modifiers}
+      {...(modifiers ? createViewModifierEventListener(modifiers) : undefined)}
+      onCheckedChange={
+        onCheckedChange
+          ? ({ nativeEvent: { checked } }) => onCheckedChange(checked)
+          : undefined
+      }>
+      {children}
+    </ToggleFloatingActionButtonNativeView>
+  );
+}
+ToggleFloatingActionButtonComponent.Icon = FABIcon;
+export { ToggleFloatingActionButtonComponent as ToggleFloatingActionButton };
+
+export interface FloatingActionButtonMenuItemProps {
+  onClick?: () => void;
+  containerColor?: ColorValue;
+  contentColor?: ColorValue;
+  modifiers?: ModifierConfig[];
+  children: React.ReactNode;
+}
+
+type NativeFloatingActionButtonMenuItemProps = Omit<
+  FloatingActionButtonMenuItemProps,
+  'onClick' | 'children'
+> & {
+  children?: React.ReactNode;
+} & ViewEvent<'onItemPressed', void>;
+
+function MenuItemIcon(props: { children: React.ReactNode }) {
+  return <SlotNativeView slotName="icon">{props.children}</SlotNativeView>;
+}
+
+function MenuItemText(props: { children: React.ReactNode }) {
+  return <SlotNativeView slotName="text">{props.children}</SlotNativeView>;
+}
+
+/**
+ * Material 3 Expressive [FloatingActionButtonMenuItem](https://developer.android.com/reference/kotlin/androidx/compose/material3/FloatingActionButtonMenuItem.composable).
+ * Must be placed inside `FloatingActionButtonMenu.Items`.
+ */
+function FloatingActionButtonMenuItemComponent(props: FloatingActionButtonMenuItemProps) {
+  const { children, onClick, modifiers, ...rest } = props;
