+@file:OptIn(ExperimentalMaterial3ExpressiveApi::class)
+
+package expo.modules.ui.button
+
+import android.graphics.Color
+import androidx.compose.material3.ExperimentalMaterial3ExpressiveApi
+import androidx.compose.material3.ToggleFloatingActionButton
+import androidx.compose.material3.ToggleFloatingActionButtonDefaults
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import expo.modules.kotlin.views.ComposeProps
+import expo.modules.kotlin.views.FunctionalComposableScope
+import expo.modules.kotlin.views.OptimizedComposeProps
+import expo.modules.ui.ToggleButtonValueChangeEvent
+import expo.modules.ui.UIComposableScope
+import expo.modules.ui.compose
+import expo.modules.ui.findChildSlotView
+
+@OptimizedComposeProps
+data class ToggleFloatingActionButtonProps(
+  val checked: Boolean = false,
+  val containerColor: Color? = null
+) : ComposeProps
+
+@Composable
+fun FunctionalComposableScope.ToggleFloatingActionButtonContent(
+  props: ToggleFloatingActionButtonProps,
+  onCheckedChange: (ToggleButtonValueChangeEvent) -> Unit
+) {
+  val iconSlotView = findChildSlotView(view, "icon")
+  val solid = props.containerColor?.compose
+
+  ToggleFloatingActionButton(
+    checked = props.checked,
+    onCheckedChange = { onCheckedChange(ToggleButtonValueChangeEvent(it)) },
+    modifier = Modifier,
+    containerColor = if (solid != null) {
+      { _ -> solid }
+    } else {
+      ToggleFloatingActionButtonDefaults.containerColor()
+    }
+  ) {
+    if (iconSlotView != null) {
+      with(UIComposableScope()) {
+        with(iconSlotView) {
+          Content()
+        }
+      }
+    } else {
+      Children(UIComposableScope())
+    }
+  }
+}
