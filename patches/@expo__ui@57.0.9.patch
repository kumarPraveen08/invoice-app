+@file:OptIn(ExperimentalMaterial3ExpressiveApi::class)
+
+package expo.modules.ui.menu
+
+import android.graphics.Color
+import androidx.compose.material3.ExperimentalMaterial3ExpressiveApi
+import androidx.compose.material3.FloatingActionButtonMenuItem
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import expo.modules.kotlin.views.ComposeProps
+import expo.modules.kotlin.views.FunctionalComposableScope
+import expo.modules.kotlin.views.OptimizedComposeProps
+import expo.modules.ui.UIComposableScope
+import expo.modules.ui.compose
+import expo.modules.ui.findChildSlotView
+
+@OptimizedComposeProps
+data class FloatingActionButtonMenuItemProps(
+  val containerColor: Color? = null,
+  val contentColor: Color? = null
+) : ComposeProps
+
+@Composable
+fun FunctionalComposableScope.FloatingActionButtonMenuItemContent(
+  props: FloatingActionButtonMenuItemProps,
+  onItemPressed: () -> Unit
+) {
+  val scope = LocalFloatingActionButtonMenuScope.current ?: return
+
+  val textSlotView = findChildSlotView(view, "text")
+  val iconSlotView = findChildSlotView(view, "icon")
+
+  val textContent: @Composable () -> Unit = {
+    textSlotView?.let {
+      with(UIComposableScope()) {
+        with(it) {
+          Content()
+        }
+      }
+    } ?: Unit
+  }
+  val iconContent: @Composable () -> Unit = {
+    iconSlotView?.let {
+      with(UIComposableScope()) {
+        with(it) {
+          Content()
+        }
+      }
+    } ?: Unit
+  }
+
+  with(scope) {
+    if (props.containerColor != null || props.contentColor != null) {
+      FloatingActionButtonMenuItem(
+        onClick = onItemPressed,
+        text = textContent,
+        icon = iconContent,
+        modifier = Modifier,
+        containerColor = props.containerColor?.compose
+          ?: MaterialTheme.colorScheme.surfaceContainer,
+        contentColor = props.contentColor?.compose
+          ?: MaterialTheme.colorScheme.onSurface
+      )
+    } else {
+      FloatingActionButtonMenuItem(
+        onClick = onItemPressed,
+        text = textContent,
+        icon = iconContent,
+        modifier = Modifier
+      )
+    }
+  }
+}
